VITE_API_URL=http://localhost:3000
# Override runtime para Electron empaquetado sin rebuild.
CONMED_RFID_API_URL=
# Bridge local de Electron para RFID
CONMED_RFID_ENABLE_SIMULATION=true
CONMED_RFID_ADB_PATH=
# Lector COM ThingMagic: si dejas vacios los comandos SERIAL_*, Electron usa el driver STPv3 nativo (38400 8N1).
# Solo define comandos SERIAL_* si quieres sobreescribir el driver con scripts PowerShell personalizados.
# Los placeholders disponibles son:
# {{deviceId}}, {{serialPortPath}}, {{androidDeviceId}}, {{tagId}}, {{payloadHex}}, {{connectionMethod}}
CONMED_RFID_SERIAL_READ_TAG_COMMAND=
CONMED_RFID_SERIAL_READ_PAYLOAD_TEXT_COMMAND=
CONMED_RFID_SERIAL_WRITE_PAYLOAD_COMMAND=
CONMED_RFID_ANDROID_READ_TAG_COMMAND=
CONMED_RFID_ANDROID_READ_PAYLOAD_TEXT_COMMAND=
CONMED_RFID_ANDROID_WRITE_PAYLOAD_COMMAND=
